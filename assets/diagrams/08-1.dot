"УчастокВыполнения" -> "ПрохождениеТочки" [dir=none, label="подтверждает", taillabel="1", headlabel="0..N", labeldistance=1.8, labelangle=28, labelfontsize=11];
"ПлановаяТочкаРейса" -> "ПрохождениеТочки" [dir=none, label="уникальное\nпрохождение", taillabel="1", headlabel="0..1", labeldistance=1.8, labelangle=28, labelfontsize=11];
