digraph G {
graph [rankdir=TB, bgcolor="transparent", pad="0.3", nodesep="0.6", ranksep="0.8", splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="#edf4fa", color="#6588a3", fontcolor="#17364f", fontname="Arial", fontsize=14, margin="0.2,0.14", penwidth=1.1];
edge [color="#586e80", fontcolor="#354b5d", fontname="Arial", fontsize=11, arrowsize=0.8, penwidth=1.1];
graph [splines=polyline];
Waiting [label="ожидает", fillcolor="#edf4fa"];
Running [label="выполняется", fillcolor="#edf4fa"];
Done [label="завершён", fillcolor="#eaf3eb"];
Review [label="требует проверки", fillcolor="#fef2da"];
Failed [label="не выполнен", fillcolor="#fbeceb"];
start [shape=circle, label="", width=0.16, height=0.16, fixedsize=true, fillcolor="#17364f", color="#17364f"];
end [shape=doublecircle, label="", width=0.18, height=0.18, fixedsize=true, fillcolor="#17364f", color="#17364f"];
start -> Waiting [label="первый выпуск рейса"];
Waiting -> Running [label="первая точка по БП-10"];
Running -> Done [label="последняя точка"];
Waiting -> Review [label="истёк срок начала"];
Running -> Review [label="истёк срок окончания"];
Waiting -> Failed [label="диспетчер подтвердил\nотмену выполнения"];
Review -> Failed [label="невыполнение\nподтверждено"];
Review -> Running [label="движение подтверждено"];
Review -> Done [label="завершение подтверждено"];
Running -> Failed [label="прекращение\nподтверждено"];
Done -> end [label=""];
Failed -> end [label=""];
{rank=same; Running; Review;}
{rank=same; Done; Failed;}
}